datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Role is a plain string ("BUYER" | "SELLER") — null until an OAuth
// sign-up completes onboarding by choosing one.
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String?
  role          String?
  bio           String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  listings         Listing[]
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  reviewsGiven     Review[]  @relation("ReviewsGiven")
  reviewsReceived  Review[]  @relation("ReviewsReceived")
  tokens           Token[]
}

// Shared table for email verification and password reset one-time links.
model Token {
  id        String   @id @default(cuid())
  token     String   @unique
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, type])
}

model Listing {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Float
  category    String
  images      String[] @default([])
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())

  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId String

  messages Message[]
  reviews  Review[]

  @@index([category])
  @@index([sellerId])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  sender   User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderId String

  receiver   User   @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId String

  @@index([listingId])
  @@index([senderId, receiverId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  reviewer   User   @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewerId String

  reviewee   User   @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  revieweeId String

  @@unique([reviewerId, listingId])
  @@index([revieweeId])
}
