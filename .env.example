# --- Database (Supabase Postgres) ---
# Pooled connection string (Supabase "Connection pooling" URI, port 6543) — used at runtime.
DATABASE_URL="postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:6543/postgres?pgbouncer=true"
# Direct (non-pooled) connection string (port 5432) — used only for running migrations.
DIRECT_URL="postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# --- Auth (NextAuth) ---
# Random secret used to sign session tokens — generate with `openssl rand -base64 32`.
NEXTAUTH_SECRET="replace-with-a-random-secret"
# Public base URL of the app, used to build email links (no trailing slash).
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (optional — omit both to disable the "Continue with Google" button) ---
# OAuth client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=""
# OAuth client secret from Google Cloud Console.
GOOGLE_CLIENT_SECRET=""

# --- Email (Resend) ---
# API key from resend.com — if unset, emails are logged to the console instead of sent (dev mode).
RESEND_API_KEY=""
# Optional "From" address for outgoing emails; must be a verified sender/domain in Resend.
EMAIL_FROM="You & Me Store <onboarding@resend.dev>"

# --- Photo uploads (Supabase Storage) ---
# Project URL from Supabase project settings (Settings -> API).
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
# Service role key from Supabase project settings — server-side only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-service-role-key"
